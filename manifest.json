{
    "$schema": "https://lenerd46.github.io/spotifyplus-docs/schemas/manifest.schema.json",
    "id": "com.lenerd.beautifullyrics",
    "name": "Beautiful Lyrics",
    "description": "Adds beautiful lyrics to Spotify!",
    "version": "1.0.0",
    "authors": [
        {
            "name": "LeNerd46",
            "url": "https://www.github.com/LeNerd46"
        }
    ],
    "tags": [
        "lyrics"
    ],
    "preview": "preview.webp",
    "api": 2,
    "assets": [
        "assets/**/*"
    ],
    "main": "dist/index.js",
    "native": {
        "apk": "lyrics.apk",
        "pluginClass": "com.lenerd.lyricsnative.NativePlugin"
    },
    "targetSpotifyVersion": "9.1.28.2252 - 9.1.94.1929"
}